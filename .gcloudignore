# This file specifies files and directories that should be ignored by gcloud commands.

# Ignore node_modules directory
node_modules/

# Ignore log files
*.log

# Ignore build directories
dist/
build/

# Ignore environment variable files
.env
.env.local

# Ignore coverage reports
coverage/

# Ignore temporary files
*.tmp
*.swp

# Ignore OS generated files
.DS_Store
Thumbs.db

google-cloud*

.git
node_modules
build
google-cloud*